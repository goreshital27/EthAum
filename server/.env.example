# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Neon PostgreSQL)
# DATABASE_URL: Pooled connection string (e.g., with -pooler in hostname)
DATABASE_URL="postgresql://user:password@ep-cool-pool-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
# DIRECT_URL: Direct unpooled connection string (used for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-cool-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Authentication & Security
JWT_SECRET="your-super-secret-jwt-key-replace-me-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# AI Provider Configuration
# Supported providers: mock, gemini, claude
AI_PROVIDER="mock"
GEMINI_API_KEY="your-gemini-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# Storage Configuration (Local or Cloud Object Storage)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="ethaum-medical-records"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
STORAGE_LOCAL_DIR="./uploads"
